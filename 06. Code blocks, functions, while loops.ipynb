      "Hurdle\n",
      "Hurdle\n",
      "Hurdle\n"
     ]
    }
   ],
   "source": [
    "number_of_hurdles = 6\n",
    "while number_of_hurdles > 0:\n",
    "    print(\"Hurdle\")\n",
    "    number_of_hurdles -= 1"
   ]
